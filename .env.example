# APP
NODE_ENV=development
PORT=3000
API_VERSION=v1
SWAGGER_ENABLED=true

# SECURITY - troque por valores longos e aleatórios
JWT_SECRET=troque-esta-chave-de-acesso-com-mais-de-16-caracteres
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=troque-esta-chave-de-refresh-com-mais-de-16-caracteres
JWT_REFRESH_EXPIRES_IN=7d
SALT=10

# Use true somente na primeira execução após alterar as models.
# Depois que o banco for atualizado, volte para false.
UPDATE_MODEL=true

# DB
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_app
DB_USERNAME=root
DB_PASSWORD=
